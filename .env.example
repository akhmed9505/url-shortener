HTTP_ADDR=:8080
# Published application port in Docker Compose.
APP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
ANALYTICS_WRITE_TIMEOUT=150ms
LOG_LEVEL=INFO
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

# Local development credentials; quote DSNs when adding shell metacharacters.
POSTGRES_DSN='postgres://shortener:shortener@localhost:5432/shortener?sslmode=disable'
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=0
POSTGRES_CONNECT_TIMEOUT=5s
# When changing this port, update POSTGRES_DSN as well.
POSTGRES_PORT=5432
# Dedicated instance started by make postgres-test-up.
TEST_POSTGRES_DSN='postgres://shortener:shortener@localhost:55432/shortener?sslmode=disable'

REDIS_ADDR=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=1h
# When changing this port, update REDIS_ADDR as well.
REDIS_PORT=6379
TEST_REDIS_ADDR=localhost:56379
